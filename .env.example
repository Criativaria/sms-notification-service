# Copy this file to .env and replace every placeholder before starting the service.
NODE_ENV=development
PORT=3000
SERVICE_URL=http://localhost:3000
PRIVATE_NETWORK_CIDRS=127.0.0.1/32,::1/128

DATABASE_URL=postgresql://sms_user:replace-with-a-local-password@localhost:5432/sms_notification?schema=public
REDIS_URL=redis://localhost:6379

SMS_PROVIDER_PRIORITY=twilio,bird
TWILIO_ACCOUNT_SID=replace-with-twilio-account-sid
TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token
TWILIO_FROM_NUMBER=replace-with-twilio-e164-sender
BIRD_API_KEY=replace-with-bird-api-key
BIRD_WORKSPACE_ID=replace-with-bird-workspace-id
BIRD_CHANNEL_ID=replace-with-bird-channel-id
BIRD_WEBHOOK_SIGNING_KEY=replace-with-bird-webhook-signing-key
# Local/demo default: point the Bird provider at the mock server in mock-servers/bird
# (docker compose up -d bird-mock) instead of the real Bird API. Comment out or remove it for a
# real Bird sandbox run. See docs/provider-sandbox.md.
# BIRD_API_BASE_URL=http://localhost:8081

MAX_MESSAGE_LENGTH=160
IDEMPOTENCY_TTL_HOURS=24
PROVIDER_MAX_RETRY_ROUNDS=3
SMS_PROVIDER_TPS=10
# Optional provider-specific overrides. Both providers remain active in the configured priority order.
# SMS_PROVIDER_TPS_TWILIO=10
# SMS_PROVIDER_TPS_BIRD=10
# Recover PROCESSING rows only after no lifecycle update for this duration. The recovery job never
# touches AWAITING_PROVIDER_RESULT, because that state can represent an ambiguous provider call.
PROCESSING_RECOVERY_INTERVAL_MS=60000
PROCESSING_STALE_AFTER_MS=300000
PROCESSING_RECOVERY_BATCH_SIZE=100
# Finalize an ambiguous timeout/network outcome as UNDELIVERED after this delay. This job never
# resends; a valid webhook received first wins and makes the expiry job a no-op.
AMBIGUOUS_OUTCOME_EXPIRY_MS=900000
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
